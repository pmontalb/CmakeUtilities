include_guard(GLOBAL)

# ==============================================================================
# Compiler Launchers (ccache, sccache, distcc, icecc)
# ==============================================================================
if (BUILD_SYSTEM_USE_SCCACHE)
    find_program(SCCACHE_PROGRAM sccache)
    mark_as_advanced(SCCACHE_PROGRAM)
    if (SCCACHE_PROGRAM)
        message(STATUS "Using sccache: ${SCCACHE_PROGRAM}")
        set(CMAKE_CXX_COMPILER_LAUNCHER "${SCCACHE_PROGRAM}" CACHE STRING "" FORCE)
        set(CMAKE_C_COMPILER_LAUNCHER "${SCCACHE_PROGRAM}" CACHE STRING "" FORCE)
    else()
        message(WARNING "sccache not found; compiler caching disabled")
    endif()
    return()
endif()

if (BUILD_SYSTEM_USE_CCACHE)
    find_program(CCACHE_PROGRAM ccache)
    mark_as_advanced(CCACHE_PROGRAM)
else()
    set(CCACHE_PROGRAM "")
endif()

if (BUILD_SYSTEM_USE_DISTCC)
    find_program(DISTCC_PROGRAM distcc)
    mark_as_advanced(DISTCC_PROGRAM)
    if (DISTCC_PROGRAM)
        if (CCACHE_PROGRAM)
            message(STATUS "Using distcc with ccache")
            set(CMAKE_CXX_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;CCACHE_PREFIX=${DISTCC_PROGRAM};${CCACHE_PROGRAM}" CACHE STRING "" FORCE)
            set(CMAKE_C_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;CCACHE_PREFIX=${DISTCC_PROGRAM};${CCACHE_PROGRAM}" CACHE STRING "" FORCE)
        else()
            message(STATUS "Using distcc without ccache")
            set(CMAKE_CXX_COMPILER_LAUNCHER "${DISTCC_PROGRAM}" CACHE STRING "" FORCE)
            set(CMAKE_C_COMPILER_LAUNCHER "${DISTCC_PROGRAM}" CACHE STRING "" FORCE)
        endif()
    else()
        message(WARNING "distcc not found")
    endif()
elseif (BUILD_SYSTEM_USE_ICECC)
    find_program(ICECC_PROGRAM icecc)
    mark_as_advanced(ICECC_PROGRAM)
    if (ICECC_PROGRAM)
        if (CCACHE_PROGRAM)
            message(STATUS "Using icecc with ccache")
            set(CMAKE_CXX_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;CCACHE_PREFIX=${ICECC_PROGRAM};${CCACHE_PROGRAM}" CACHE STRING "" FORCE)
            set(CMAKE_C_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;CCACHE_PREFIX=${ICECC_PROGRAM};${CCACHE_PROGRAM}" CACHE STRING "" FORCE)
        else()
            message(STATUS "Using icecc without ccache")
            set(CMAKE_CXX_COMPILER_LAUNCHER "${ICECC_PROGRAM}" CACHE STRING "" FORCE)
            set(CMAKE_C_COMPILER_LAUNCHER "${ICECC_PROGRAM}" CACHE STRING "" FORCE)
        endif()
    else()
        message(WARNING "icecc not found")
    endif()
elseif (BUILD_SYSTEM_USE_CCACHE)
    if (CCACHE_PROGRAM)
        message(STATUS "Using ccache: ${CCACHE_PROGRAM}")
        set(CMAKE_CXX_COMPILER_LAUNCHER "${CCACHE_PROGRAM}" CACHE STRING "" FORCE)
        set(CMAKE_C_COMPILER_LAUNCHER "${CCACHE_PROGRAM}" CACHE STRING "" FORCE)
    else()
        message(WARNING "ccache not found; skipping")
    endif()
endif()
